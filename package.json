{
  "name": "chat-connect",
  "version": "0.2.1-rc.4",
  "private": true,
  "description": "Chat Connect: a local AI workspace with a graphical first-run setup wizard",
  "author": "Chat Connect",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "start": "node scripts/run-electron-vite.mjs preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && node scripts/prepare-node.mjs && electron-builder --dir",
    "dist": "npm run build && node scripts/prepare-node.mjs && electron-builder",
    "dist:mac": "npm run build && node scripts/prepare-node.mjs && electron-builder --mac --arm64",
    "dist:win": "npm run build && node scripts/prepare-node.mjs && electron-builder --win --x64",
    "prepare:node": "node scripts/prepare-node.mjs",
    "upgrade:core": "node scripts/upgrade-core.mjs",
    "dist:mac:x64": "npm run build && node scripts/prepare-node.mjs && electron-builder --mac --x64",
    "dist:linux": "npm run build && node scripts/prepare-node.mjs && electron-builder --linux --x64"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "~1.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.4",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.4",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.4",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.4",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.4",
    "@deepseek-ai/dsh-deepseek-account": "0.2.1-rc.4",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.4",
    "@deepseek-ai/dsh-output-retention": "0.2.1-rc.4",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.4",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.4",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-telemetry": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-title-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.4",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.4",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.4",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.4",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.4",
    "js-yaml": "^4.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.1-rc.4": true,
    "fsevents@2.3.3": true,
    "@google/genai": true,
    "electron-winstaller": true,
    "koffi": true,
    "node-pty": true,
    "protobufjs": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shangguanjunwei/chat-connect.git"
  }
}
